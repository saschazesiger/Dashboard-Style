[
  "animation ds-fade-in - 150 0 1 --ds-ease-in-out",
  "animation ds-fade-out - 100 0 1 --ds-ease-in",
  "transition background-color - 150 0 1 --ds-ease-in-out",
  "transition border-bottom-color - 150 0 1 --ds-ease-in-out",
  "transition border-left-color - 150 0 1 --ds-ease-in-out",
  "transition border-right-color - 150 0 1 --ds-ease-in-out",
  "transition border-top-color - 150 0 1 --ds-ease-in-out",
  "transition clip-path ::after 250 0 1 --ds-ease-out",
  "transition clip-path ::before 150 0 1 --ds-ease-in",
  "transition clip-path ::before 250 50 1 --ds-ease-out"
]
