{
  "name": "ripple",
  "group": "motion",
  "order": 9990,
  "docsOrder": 340,
  "need": "Answer a press with a ripple from the pointer, and hold quick presses visible",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-press-ripple",
    "ds-press-ripple--out",
    "ds-pressed",
    "ds-ripples"
  ],
  "attributes": [
    "data-ds-ripple"
  ],
  "requires": [
    "button"
  ],
  "context": [
    "alert",
    "card",
    "chart",
    "chip",
    "combobox",
    "disclosure",
    "drag",
    "form",
    "list",
    "menu",
    "shell",
    "table",
    "tabs",
    "tile",
    "utilities"
  ],
  "hooks": {
    "--ds-ripple-color": {
      "default": "`currentColor`",
      "description": "the pointer ripple of every action ([ripple](components.md#ripple))"
    },
    "--ds-btn-state-focus-opacity": {
      "owner": "button"
    },
    "--ds-btn-state-opacity": {
      "owner": "button"
    },
    "--ds-btn-state-pressed-opacity": {
      "owner": "button"
    },
    "--ds-table-row-hover": {
      "owner": "table"
    }
  },
  "keyframes": [
    "ds-press-ripple"
  ],
  "js": [
    "ripple"
  ],
  "progressive": [
    "overflow-clip-margin"
  ],
  "ripple": true,
  "rippleHosts": [
    "[data-ds-ripple]"
  ],
  "stateClasses": [
    "ds-pressed",
    "ds-ripples"
  ],
  "exceptions": {
    "physical": {
      ".ds-press-ripple: left": "pointer coordinates: --ds-ripple-x from the host's left",
      ".ds-ripples tr > :is(td, th) > .ds-press-ripple::before: left": "pointer coordinates: --ds-ripple-x from the cell's left",
      ".ds-ripples .ds-tabs__tab > .ds-press-ripple::before: left": "pointer coordinates: --ds-ripple-x from the tab's left"
    }
  }
}
