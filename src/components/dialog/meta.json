{
  "name": "dialog",
  "group": "overlays",
  "order": 310,
  "docsOrder": 250,
  "need": "Ask for a decision or a short task that blocks the page until it is done",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-dialog",
    "ds-dialog--bottom",
    "ds-dialog--closing",
    "ds-dialog--contained",
    "ds-dialog--full",
    "ds-dialog--full-narrow",
    "ds-dialog--hidden",
    "ds-dialog--nested",
    "ds-dialog--wide",
    "ds-dialog__actions",
    "ds-dialog__backdrop",
    "ds-dialog__body",
    "ds-dialog__box",
    "ds-dialog__head",
    "ds-dialog__list",
    "ds-dialog__text",
    "ds-dialog__title"
  ],
  "attributes": [
    "data-ds-sentinel",
    "data-ds-text",
    "data-scrolled",
    "data-state"
  ],
  "requires": [
    "button"
  ],
  "context": [],
  "hooks": {
    "--ds-dialog-width": {
      "default": "400px",
      "description": "dialog"
    },
    "--ds-dialog-border": {
      "default": "`1px solid transparent` (visible in forced colors)",
      "description": "dialog edge"
    },
    "--ds-dialog-shadow": {
      "default": "`--ds-elev-overlay`",
      "description": "dialog"
    },
    "--ds-dialog-scrim": {
      "default": "`--ds-scrim`",
      "description": "the dialog's backdrop; `.ds-dialog--nested` sets it to `--ds-scrim-nested`"
    },
    "--ds-dialog-width-wide": {
      "default": "560px",
      "description": "`.ds-dialog--wide`"
    },
    "--ds-dialog-height": {
      "default": "auto (capped by the window)",
      "description": "the dialog box; a fixed height keeps a box with a filtered list from jumping"
    },
    "--ds-dialog-full-radius": {
      "default": "0",
      "description": "the box of a full-screen dialog (`.ds-dialog--full`, `--full-narrow`)"
    }
  },
  "keyframes": [
    "ds-drop-out",
    "ds-fade-in",
    "ds-fade-out",
    "ds-grow-in",
    "ds-lift-in",
    "ds-shrink-out"
  ],
  "js": [
    "overlay"
  ],
  "progressive": [
    "@starting-style",
    "allow-discrete",
    "scrollbar-color"
  ],
  "ripple": false
}
