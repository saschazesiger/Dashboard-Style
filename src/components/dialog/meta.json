{
  "name": "dialog",
  "group": "overlays",
  "order": 260,
  "docsOrder": 250,
  "need": "Ask for a decision or a short task that blocks the page until it is done",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-dialog",
    "ds-dialog--bottom",
    "ds-dialog--closing",
    "ds-dialog--contained",
    "ds-dialog--full",
    "ds-dialog--full-narrow",
    "ds-dialog--hidden",
    "ds-dialog--lg",
    "ds-dialog--nested",
    "ds-dialog--sm",
    "ds-dialog--wide",
    "ds-dialog--xl",
    "ds-dialog__actions",
    "ds-dialog__backdrop",
    "ds-dialog__body",
    "ds-dialog__box",
    "ds-dialog__head",
    "ds-dialog__list",
    "ds-dialog__text",
    "ds-dialog__title"
  ],
  "attributes": [
    "data-ds-sentinel",
    "data-ds-text",
    "data-scrolled",
    "data-state",
    "data-toast-reserve"
  ],
  "requires": [
    "button"
  ],
  "context": [],
  "hooks": {
    "--ds-dialog-width": {
      "default": "400px",
      "description": "dialog"
    },
    "--ds-dialog-width-sm": {
      "default": "320px",
      "description": "`.ds-dialog--sm`"
    },
    "--ds-dialog-width-lg": {
      "default": "560px",
      "description": "`.ds-dialog--lg`"
    },
    "--ds-dialog-width-xl": {
      "default": "720px",
      "description": "`.ds-dialog--xl`"
    },
    "--ds-dialog-width-wide": {
      "default": "560px",
      "description": "**deprecated** name of `--ds-dialog-width-lg`, read after it"
    },
    "--ds-dialog-padding": {
      "default": "`--ds-space-6`",
      "description": "the box's padding at the comfortable density"
    },
    "--ds-dialog-radius": {
      "default": "`--ds-radius-dialog`",
      "description": "the box's radius at the default shape"
    },
    "--ds-dialog-head-height": {
      "default": "56px",
      "description": "`.ds-dialog__head` at the comfortable density"
    },
    "--ds-dialog-border": {
      "default": "`1px solid transparent` (visible in forced colors)",
      "description": "dialog edge"
    },
    "--ds-dialog-shadow": {
      "default": "`--ds-elev-overlay`",
      "description": "dialog"
    },
    "--ds-dialog-scrim": {
      "default": "`--ds-scrim`",
      "description": "the dialog's backdrop; `.ds-dialog--nested` sets it to `--ds-scrim-nested`"
    },
    "--ds-dialog-height": {
      "default": "auto (capped by the window)",
      "description": "the dialog box; a fixed height keeps a box with a filtered list from jumping"
    },
    "--ds-dialog-full-radius": {
      "default": "0px",
      "description": "the box of a full-screen dialog (`.ds-dialog--full`, `--full-narrow`)"
    }
  },
  "keyframes": [
    "ds-drop-out",
    "ds-fade-in",
    "ds-fade-out",
    "ds-grow-in",
    "ds-lift-in",
    "ds-shrink-out"
  ],
  "js": [
    "dialog",
    "overlay"
  ],
  "module": true,
  "progressive": [
    "scrollbar-color"
  ],
  "ripple": false,
  "labExempt": {
    "DS.dialog.confirm": "the same function as DS.overlay.confirm, shown in the entry dialog-work",
    "DS.dialog.alert": "the same function as DS.overlay.alert, shown in the entry dialog-work",
    "DS.dialog.prompt": "the same function as DS.overlay.prompt, shown in the entry dialog-work",
    "DS.dialog.form": "events only: a form dialog moves as a dialog does",
    "DS.dialog.create": "events only, no motion"
  }
}
