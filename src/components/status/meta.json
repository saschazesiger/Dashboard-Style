{
  "name": "status",
  "group": "feedback",
  "order": 160,
  "docsOrder": 140,
  "classes": [
    "ds-status",
    "ds-status--error",
    "ds-status--ok",
    "ds-status--running",
    "ds-status--warning",
    "ds-status__spinner",
    "ds-tag",
    "ds-tag--neutral"
  ],
  "attributes": [],
  "requires": [
    "spinner"
  ],
  "context": [],
  "hooks": {
    "--ds-status-radius": {
      "default": "`--ds-radius-md`",
      "description": "status chip"
    },
    "--ds-tag-bg": {
      "default": "`--ds-accent`, `--ds-on-accent` (`--neutral`: `--ds-surface-high`, `--ds-text`)",
      "description": "a tag (`.ds-tag`)"
    },
    "--ds-tag-color": {
      "default": "`--ds-accent`, `--ds-on-accent` (`--neutral`: `--ds-surface-high`, `--ds-text`)",
      "description": "a tag (`.ds-tag`)"
    },
    "--ds-tag-height": {
      "default": "24px",
      "description": "a tag's height (its radius is half of it)"
    },
    "--ds-status-spinner-width": {
      "default": "2px",
      "description": "the ring width of the spinner in a running status chip"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [
    "@starting-style"
  ],
  "ripple": false
}
