{
  "name": "utilities",
  "group": "layout",
  "order": 10,
  "docsOrder": 350,
  "classes": [
    "ds-center",
    "ds-divider",
    "ds-divider--inset",
    "ds-divider--label",
    "ds-divider--vertical",
    "ds-hover-actions",
    "ds-hover-host",
    "ds-icon--fillable",
    "ds-icon--filled",
    "ds-kbd",
    "ds-meta",
    "ds-muted",
    "ds-nowrap",
    "ds-num",
    "ds-pressable",
    "ds-pressable--inset",
    "ds-pressable--lg",
    "ds-sr",
    "ds-touch"
  ],
  "attributes": [
    "data-ds-shown"
  ],
  "requires": [],
  "context": [
    "card",
    "ripple",
    "shell",
    "table"
  ],
  "hooks": {
    "--ds-pressable-radius": {
      "default": "`--ds-radius-sm`",
      "description": "`.ds-pressable`, the press model on a project element"
    },
    "--ds-pressable-layer": {
      "default": "`currentColor`",
      "description": "the colour of the state layer of `.ds-pressable`"
    },
    "--ds-kbd-border": {
      "default": "`--ds-line-2`, `--ds-surface`",
      "description": "`.ds-kbd`: the box of a key"
    },
    "--ds-kbd-bg": {
      "default": "`--ds-line-2`, `--ds-surface`",
      "description": "`.ds-kbd`: the box of a key"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [
    "text-wrap"
  ],
  "ripple": true,
  "rippleHosts": [
    ".ds-pressable"
  ]
}
