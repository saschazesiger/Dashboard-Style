{
  "name": "chart",
  "group": "data",
  "order": 160,
  "docsOrder": 320,
  "need": "Show a share, a figure per day or week, or a trend at a glance",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-columns",
    "ds-columns--grouped",
    "ds-columns--mini",
    "ds-columns__col",
    "ds-columns__col--error",
    "ds-columns__col--highlight",
    "ds-columns__col--s2",
    "ds-columns__col--s3",
    "ds-columns__col--s4",
    "ds-columns__col--warning",
    "ds-columns__fill",
    "ds-columns__group",
    "ds-columns__group--current",
    "ds-columns__groups",
    "ds-columns__label",
    "ds-columns__plot",
    "ds-columns__value",
    "ds-legend",
    "ds-legend__key",
    "ds-legend__key--error",
    "ds-legend__key--neutral",
    "ds-legend__key--s2",
    "ds-legend__key--s3",
    "ds-legend__key--s4",
    "ds-legend__key--warning",
    "ds-meter",
    "ds-meter--error",
    "ds-meter--neutral",
    "ds-meter--warning"
  ],
  "attributes": [],
  "requires": [],
  "context": [],
  "hooks": {
    "--ds-meter-height": {
      "default": "4px",
      "description": "`.ds-meter`: the base height, 1px per size step (its rest radius is half of it)"
    },
    "--ds-meter-track": {
      "default": "`--ds-chart-track`, `--ds-chart-1` (tones: `--ds-tone`, or `--ds-chart-neutral`, `--ds-chart-warning`, `--ds-chart-error`)",
      "description": "`.ds-meter`: the track, the fill"
    },
    "--ds-meter-color": {
      "default": "`--ds-chart-track`, `--ds-chart-1` (tones: `--ds-tone`, or `--ds-chart-neutral`, `--ds-chart-warning`, `--ds-chart-error`)",
      "description": "`.ds-meter`: the track, the fill"
    },
    "--ds-columns-height": {
      "default": "120px",
      "description": "the plot of `.ds-columns` at size md, comfortable density: 24px per size step, 12px per density step (`--mini`: 32px)"
    },
    "--ds-columns-radius": {
      "default": "`--ds-radius-xs`",
      "description": "the rounded data end of a column (times `--ds-shape`)"
    },
    "--ds-columns-group-min": {
      "default": "56px",
      "description": "the least width of a group of `.ds-columns--grouped`"
    },
    "--ds-chart-color": {
      "default": "`--ds-chart-1` (series and tone modifiers set it)",
      "description": "the colour of a column or a legend key"
    },
    "--ds-legend-key-size": {
      "default": "12px",
      "description": "the key of a `.ds-legend` entry, 2px per size step"
    },
    "--ds-chart-forced-ink": {
      "default": "`CanvasText`",
      "description": "the fills of columns and legend keys in forced colours; a component that lays them on a system fill of its own sets it"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ":is(button, a).ds-columns__col"
  ]
}
