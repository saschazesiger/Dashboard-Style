{
  "name": "tabs",
  "group": "navigation",
  "order": 360,
  "docsOrder": 30,
  "classes": [
    "ds-tabs",
    "ds-tabs--fill",
    "ds-tabs--flush",
    "ds-tabs__indicator",
    "ds-tabs__panel",
    "ds-tabs__tab"
  ],
  "attributes": [
    "data-label"
  ],
  "requires": [],
  "context": [
    "indicator",
    "ripple"
  ],
  "hooks": {
    "--ds-tabs-height": {
      "default": "48px",
      "description": "a tab (the state layer is a pill `--ds-space-1` inside it)"
    },
    "--ds-tabs-indicator-height": {
      "default": "3px, `--ds-primary`",
      "description": "the bar under the selected tab"
    },
    "--ds-tabs-indicator-color": {
      "default": "3px, `--ds-primary`",
      "description": "the bar under the selected tab"
    }
  },
  "keyframes": [],
  "js": [
    "indicator"
  ],
  "progressive": [
    "scrollbar-color"
  ],
  "ripple": true,
  "rippleHosts": [
    ".ds-tabs__tab"
  ]
}
