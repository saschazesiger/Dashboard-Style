{
  "name": "menu",
  "group": "overlays",
  "order": 270,
  "docsOrder": 240,
  "need": "Offer the actions of one item, or the overflow of a toolbar, from a button",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-menu",
    "ds-menu__check",
    "ds-menu__content",
    "ds-menu__description",
    "ds-menu__divider",
    "ds-menu__heading",
    "ds-menu__item",
    "ds-menu__item--danger",
    "ds-menu__label",
    "ds-menu__meta",
    "ds-menu__shortcut"
  ],
  "attributes": [
    "data-anchored",
    "data-ds-overflow-end",
    "data-ds-overflow-start",
    "data-placement",
    "data-state"
  ],
  "requires": [],
  "context": [
    "ripple"
  ],
  "hooks": {
    "--ds-menu-item-height": {
      "default": "48px",
      "description": "menu item (and action sheet row) at size md and the comfortable density"
    },
    "--ds-menu-font": {
      "default": "`--ds-size-font`, else `--ds-font-body`",
      "description": "the items' type"
    },
    "--ds-menu-padding": {
      "default": "`--ds-space-2`",
      "description": "the menu's block padding at the comfortable density"
    },
    "--ds-menu-radius": {
      "default": "`--ds-radius-xs`",
      "description": "the menu's radius at the default shape"
    },
    "--ds-menu-danger-color": {
      "default": "`--ds-error`",
      "description": "the ink of `.ds-menu__item--danger`"
    },
    "--ds-scroll-fade": {
      "owner": "scroller"
    }
  },
  "keyframes": [
    "ds-clip-in",
    "ds-fade-in",
    "ds-scroll-edge-end",
    "ds-scroll-edge-start"
  ],
  "js": [
    "menu",
    "overlay"
  ],
  "module": true,
  "progressive": [
    "anchor positioning",
    "scroll-driven",
    "scrollbar-color"
  ],
  "ripple": true,
  "rippleHosts": [
    ".ds-menu__item"
  ],
  "labExempt": {
    "DS.menu.create": "events only, no motion"
  },
  "exceptions": {
    "physical": {
      ".ds-menu: inset": "script coordinates: --ds-menu-x from the left"
    }
  }
}
