{
  "name": "button",
  "group": "actions",
  "order": 30,
  "docsOrder": 50,
  "classes": [
    "ds-btn",
    "ds-btn--adaptive",
    "ds-btn--block",
    "ds-btn--disc",
    "ds-btn--disclosure",
    "ds-btn--done",
    "ds-btn--elevated",
    "ds-btn--failed",
    "ds-btn--filled",
    "ds-btn--ghost",
    "ds-btn--icon",
    "ds-btn--outlined",
    "ds-btn--primary",
    "ds-btn--quiet",
    "ds-btn--sm",
    "ds-btn--text",
    "ds-btn--tonal",
    "ds-btn__face",
    "ds-btn__face--busy",
    "ds-btn__face--done",
    "ds-btn__face--failed",
    "ds-btn__faces",
    "ds-btn__label",
    "ds-link--quiet",
    "ds-link-btn",
    "ds-link-btn--quiet"
  ],
  "attributes": [],
  "requires": [
    "spinner"
  ],
  "context": [
    "dialog",
    "indicator",
    "page",
    "ripple",
    "sheet"
  ],
  "hooks": {
    "--ds-btn-height": {
      "default": "40px",
      "description": "button: the base height (size md, comfortable density) that size and density steps apply to ([options.md](options.md)); other components read it to line up with a button"
    },
    "--ds-btn-height-exact": {
      "default": "unset",
      "description": "button: a fixed height that ignores size and density (never the touch minimum)"
    },
    "--ds-btn-padding-x": {
      "default": "`--ds-space-4` (`--text`, `--ghost`, `--sm`: `--ds-space-3`)",
      "description": "button: the base side padding, 4px more or less per size step"
    },
    "--ds-btn-padding-start": {
      "default": "`= padding-x`; before a leading icon `--ds-space-3` (4px more per size above md, never more than the end padding)",
      "description": "button"
    },
    "--ds-btn-radius": {
      "default": "`--ds-radius-action`",
      "description": "button (at most half the height, times `--ds-shape`)"
    },
    "--ds-btn-radius-pressed": {
      "default": "`--ds-radius-action-pressed`",
      "description": "button while pressed (times `--ds-shape`; never rounder than the rest radius)"
    },
    "--ds-btn-font": {
      "default": "`--ds-size-font` of the size class, else `--ds-font-label`",
      "description": "button"
    },
    "--ds-btn-bg": {
      "default": "per variant",
      "description": "button fill, label, border colour"
    },
    "--ds-btn-color": {
      "default": "per variant",
      "description": "button fill, label, border colour"
    },
    "--ds-btn-border": {
      "default": "per variant",
      "description": "button fill, label, border colour"
    },
    "--ds-btn-shadow": {
      "default": "none (`--elevated`: `--ds-elev-1`)",
      "description": "resting elevation"
    },
    "--ds-btn-state": {
      "default": "`currentColor`",
      "description": "colour of the hover/press layer"
    },
    "--ds-btn-state-opacity": {
      "default": "`--ds-state-hover`, `--ds-state-focus`, `--ds-state-pressed` (`--disc`: 1)",
      "description": "layer strength on hover, keyboard focus, press"
    },
    "--ds-btn-state-focus-opacity": {
      "default": "`--ds-state-hover`, `--ds-state-focus`, `--ds-state-pressed` (`--disc`: 1)",
      "description": "layer strength on hover, keyboard focus, press"
    },
    "--ds-btn-state-pressed-opacity": {
      "default": "`--ds-state-hover`, `--ds-state-focus`, `--ds-state-pressed` (`--disc`: 1)",
      "description": "layer strength on hover, keyboard focus, press"
    },
    "--ds-btn-hover-color": {
      "default": "the resting values",
      "description": "hover label and border"
    },
    "--ds-btn-hover-border": {
      "default": "the resting values",
      "description": "hover label and border"
    },
    "--ds-btn-hover-shadow": {
      "default": "the resting shadow (`--filled`: `--ds-elev-hover`, `--elevated`: `--ds-elev-2`)",
      "description": "hover elevation"
    },
    "--ds-btn-hover-decoration": {
      "default": "none",
      "description": "e.g. `underline` for text buttons"
    },
    "--ds-btn-icon-size": {
      "default": "40px",
      "description": "`--icon` buttons: the base size, 8px more or less per size step"
    },
    "--ds-btn-sm-height": {
      "default": "32px",
      "description": "the fixed height of the deprecated `.ds-btn--sm` (density does not change it)"
    },
    "--ds-btn-sm-icon-size": {
      "default": "32px",
      "description": "the fixed size of the deprecated `.ds-btn--sm.ds-btn--icon`; a `.ds-drawer__row` item keeps that much room for its action"
    },
    "--ds-btn-quiet-color": {
      "default": "`--ds-text-2`",
      "description": "`--quiet` label"
    },
    "--ds-btn-disabled-bg": {
      "default": "from `--ds-disabled-fill`",
      "description": "disabled container"
    },
    "--ds-btn-disabled-border": {
      "default": "from `--ds-disabled-fill`",
      "description": "disabled container"
    }
  },
  "keyframes": [
    "ds-draw"
  ],
  "js": [],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-btn"
  ],
  "exceptions": {
    "ripple": {
      ".ds-link-btn": "an inline text link: no ripple and no morph (they would reach outside the text line)"
    }
  }
}
