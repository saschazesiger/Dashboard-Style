{
  "name": "drag",
  "group": "forms",
  "order": 210,
  "docsOrder": 330,
  "need": "Reorder rows by a grip, or drop files onto a zone",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-dropzone",
    "ds-dropzone__browse",
    "ds-dropzone__disc",
    "ds-dropzone__hint",
    "ds-dropzone__idle",
    "ds-dropzone__input",
    "ds-dropzone__over",
    "ds-dropzone__title",
    "ds-grip"
  ],
  "attributes": [
    "data-ds-dragging",
    "data-ds-dragover"
  ],
  "requires": [
    "form"
  ],
  "context": [
    "ripple"
  ],
  "hooks": {
    "--ds-dropzone-border": {
      "default": "`1px dashed var(--ds-outline)`",
      "description": "the border of a `.ds-dropzone` ([file upload](components.md#file-upload))"
    }
  },
  "keyframes": [],
  "js": [
    "dom",
    "motion"
  ],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-dropzone"
  ]
}
