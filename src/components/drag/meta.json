{
  "name": "drag",
  "group": "forms",
  "order": 300,
  "docsOrder": 330,
  "need": "Reorder rows by a grip, or drop files onto a zone",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-dropzone",
    "ds-dropzone--inline",
    "ds-dropzone__browse",
    "ds-dropzone__disc",
    "ds-dropzone__hint",
    "ds-dropzone__idle",
    "ds-dropzone__input",
    "ds-dropzone__over",
    "ds-dropzone__title",
    "ds-grip"
  ],
  "attributes": [
    "data-ds-dragging",
    "data-ds-dragover"
  ],
  "requires": [
    "form"
  ],
  "context": [],
  "hooks": {
    "--ds-dropzone-border": {
      "default": "`1px dashed var(--ds-outline)`",
      "description": "the border of a `.ds-dropzone` ([file upload](components.md#file-upload))"
    },
    "--ds-dropzone-padding": {
      "default": "`--ds-space-6`",
      "description": "`.ds-dropzone`: the block padding at comfortable density, 2px less per density step (the inline padding stays `--ds-space-5`)"
    },
    "--ds-dropzone-radius": {
      "default": "`--ds-radius-card`",
      "description": "`.ds-dropzone`, times `--ds-shape`"
    },
    "--ds-file-button-height": {
      "default": "32px",
      "description": "the browser's button in `.ds-input[type=\"file\"]`: the base height that size and density steps apply to"
    },
    "--ds-input-height": {
      "owner": "form"
    },
    "--ds-field-error-color": {
      "owner": "form"
    }
  },
  "keyframes": [],
  "js": [
    "dom",
    "motion"
  ],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-dropzone"
  ]
}
