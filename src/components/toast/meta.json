{
  "name": "toast",
  "group": "overlays",
  "order": 320,
  "docsOrder": 270,
  "classes": [
    "ds-toast",
    "ds-toast--error",
    "ds-toast--info",
    "ds-toast--shown",
    "ds-toast__close",
    "ds-toast__text",
    "ds-toasts"
  ],
  "attributes": [
    "data-drawer-collapsed",
    "data-drawer-hidden",
    "data-drawer-open",
    "data-ds-vt",
    "data-follow",
    "data-toast-reserve"
  ],
  "requires": [
    "button"
  ],
  "context": [
    "dialog",
    "shell"
  ],
  "hooks": {
    "--ds-toast-action-color": {
      "default": "`--ds-inverse-primary`",
      "description": "a text button in a snackbar (`.ds-toast__action`, Undo)"
    },
    "--ds-toast-close-size": {
      "default": "36px",
      "description": "the close button of a snackbar"
    }
  },
  "keyframes": [
    "ds-fade-in",
    "ds-lift-in"
  ],
  "js": [
    "overlay"
  ],
  "progressive": [
    "View Transitions"
  ],
  "ripple": false,
  "exceptions": {
    "physical": {
      ".ds-toasts: left": "script coordinate: --ds-toast-left, and DS.overlay reads the computed left back"
    }
  }
}
