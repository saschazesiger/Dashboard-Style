{
  "name": "alert",
  "group": "feedback",
  "order": 170,
  "docsOrder": 160,
  "need": "Tell the user something about a page or a section, in place, with an icon and a word",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-alert",
    "ds-alert--error",
    "ds-alert--plain",
    "ds-alert--success",
    "ds-alert--warning",
    "ds-alert__actions",
    "ds-alert__text",
    "ds-alert__title",
    "ds-errors",
    "ds-errors__chevron"
  ],
  "attributes": [],
  "requires": [
    "button"
  ],
  "context": [
    "ripple"
  ],
  "hooks": {
    "--ds-alert-bg": {
      "default": "`--ds-surface-low`, `--ds-text`",
      "description": "the neutral alert (kinds set them from their own hooks)"
    },
    "--ds-alert-color": {
      "default": "`--ds-surface-low`, `--ds-text`",
      "description": "the neutral alert (kinds set them from their own hooks)"
    },
    "--ds-alert-icon": {
      "default": "`--ds-primary`",
      "description": "the neutral alert's icon and edge colour"
    },
    "--ds-alert-edge": {
      "default": "0",
      "description": "the width of an alert's leading edge (`4px`: an edge in the icon colour)"
    },
    "--ds-alert-success-bg": {
      "default": "`--ds-success-container`, `--ds-on-success-container`, `--ds-success`",
      "description": "`.ds-alert--success`"
    },
    "--ds-alert-success-color": {
      "default": "`--ds-success-container`, `--ds-on-success-container`, `--ds-success`",
      "description": "`.ds-alert--success`"
    },
    "--ds-alert-success-icon": {
      "default": "`--ds-success-container`, `--ds-on-success-container`, `--ds-success`",
      "description": "`.ds-alert--success`"
    },
    "--ds-alert-warning-bg": {
      "default": "`--ds-warning-surface`, `--ds-text`, `--ds-warning`",
      "description": "`.ds-alert--warning`"
    },
    "--ds-alert-warning-color": {
      "default": "`--ds-warning-surface`, `--ds-text`, `--ds-warning`",
      "description": "`.ds-alert--warning`"
    },
    "--ds-alert-warning-icon": {
      "default": "`--ds-warning-surface`, `--ds-text`, `--ds-warning`",
      "description": "`.ds-alert--warning`"
    },
    "--ds-alert-error-bg": {
      "default": "`--ds-error-container`, `--ds-on-error-container`, `--ds-error`",
      "description": "`.ds-alert--error` (its buttons take `--ds-alert-error-color`)"
    },
    "--ds-alert-error-color": {
      "default": "`--ds-error-container`, `--ds-on-error-container`, `--ds-error`",
      "description": "`.ds-alert--error` (its buttons take `--ds-alert-error-color`)"
    },
    "--ds-alert-error-icon": {
      "default": "`--ds-error-container`, `--ds-on-error-container`, `--ds-error`",
      "description": "`.ds-alert--error` (its buttons take `--ds-alert-error-color`)"
    },
    "--ds-alert-text-basis": {
      "default": "256px",
      "description": "the narrowest text of an alert with `.ds-alert__actions` before the actions wrap"
    },
    "--ds-btn-height": {
      "owner": "button"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-errors summary"
  ],
  "motionExceptions": {
    "transition": {
      "rotate": {
        ".ds-errors .ds-errors__chevron": "disclosure chevrons: the errors list chevron turns 180deg with the list (D25)"
      }
    }
  }
}
