{
  "name": "savebar",
  "group": "forms",
  "order": 340,
  "docsOrder": 290,
  "need": "Save or discard unsaved changes from a bar that appears when something changed",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-savebar",
    "ds-savebar__actions",
    "ds-savebar__bar",
    "ds-savebar__text"
  ],
  "attributes": [
    "data-ds-savebar",
    "data-ds-savebar-rest",
    "data-toast-reserve"
  ],
  "requires": [],
  "context": [
    "page",
    "shell"
  ],
  "hooks": {
    "--ds-savebar-offset": {
      "default": "`--ds-space-4`",
      "description": "save bar: distance from the view's bottom edge"
    },
    "--ds-savebar-inset": {
      "default": "the page pad (`--ds-content-pad-x`)",
      "description": "save bar: distance from the view's sides (the bar is at most `--ds-content-max` wide)"
    },
    "--ds-savebar-min-height": {
      "default": "56px",
      "description": "save bar"
    },
    "--ds-savebar-radius": {
      "default": "`--ds-radius-card`",
      "description": "save bar"
    },
    "--ds-savebar-bg": {
      "default": "`--ds-surface-popover`, `--ds-elev-overlay`",
      "description": "save bar surface and elevation"
    },
    "--ds-savebar-shadow": {
      "default": "`--ds-surface-popover`, `--ds-elev-overlay`",
      "description": "save bar surface and elevation"
    }
  },
  "keyframes": [],
  "js": [
    "overlay"
  ],
  "progressive": [
    "@starting-style",
    "allow-discrete"
  ],
  "ripple": false
}
