{
  "name": "card",
  "group": "layout",
  "order": 80,
  "docsOrder": 60,
  "need": "Group related content in a block, or let a whole block open or pick something",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-card",
    "ds-card--elevated",
    "ds-card--filled",
    "ds-card--interactive",
    "ds-card__action",
    "ds-card__link",
    "ds-card__links",
    "ds-card__row",
    "ds-card__subtitle",
    "ds-card__title",
    "ds-more",
    "ds-subsection"
  ],
  "attributes": [],
  "requires": [
    "button",
    "utilities"
  ],
  "context": [
    "badge",
    "chip",
    "page",
    "ripple",
    "status",
    "switch",
    "table"
  ],
  "hooks": {
    "--ds-card-padding": {
      "default": "`--ds-space-6`",
      "description": "card padding"
    },
    "--ds-card-padding-sm": {
      "default": "`--ds-space-4`",
      "description": "card padding at 600px and below"
    },
    "--ds-card-padding-filled": {
      "default": "`--ds-space-5`",
      "description": "`.ds-card--filled` padding"
    },
    "--ds-card-title-line": {
      "default": "24px",
      "description": "line height of `.ds-card__title`; a button, switch or chip in the header row overhangs it, a status chip, badge or tag sits on it (set it with a type role that changes the subtitle line)"
    },
    "--ds-card-hover-shadow": {
      "default": "none",
      "description": "`.ds-card--interactive` on hover (a theme may set `var(--ds-elev-hover)`); never a lift"
    },
    "--ds-card-selected-bg": {
      "default": "`--ds-accent`",
      "description": "a selected interactive card"
    },
    "--ds-selected-ring": {
      "default": "`--ds-primary`",
      "description": "the inset ring of a selected tile or card"
    },
    "--ds-card-shadow": {
      "default": "`--ds-elev-1`",
      "description": "`.ds-card--elevated`"
    },
    "--ds-btn-height": {
      "owner": "button"
    },
    "--ds-chip-height": {
      "owner": "chip"
    },
    "--ds-switch-height": {
      "owner": "switch"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-card--interactive"
  ]
}
