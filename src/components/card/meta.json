{
  "name": "card",
  "group": "layout",
  "order": 80,
  "docsOrder": 60,
  "need": "Group related content in a block, or let a whole block open or pick something",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-card",
    "ds-card--elevated",
    "ds-card--filled",
    "ds-card--horizontal",
    "ds-card--interactive",
    "ds-card--outlined",
    "ds-card--selectable",
    "ds-card__action",
    "ds-card__body",
    "ds-card__check",
    "ds-card__link",
    "ds-card__links",
    "ds-card__media",
    "ds-card__more",
    "ds-card__row",
    "ds-card__section",
    "ds-card__subtitle",
    "ds-card__title",
    "ds-more",
    "ds-subsection"
  ],
  "attributes": [],
  "requires": [
    "button",
    "utilities"
  ],
  "context": [
    "badge",
    "chip",
    "disclosure",
    "page",
    "ripple",
    "status",
    "switch",
    "table"
  ],
  "hooks": {
    "--ds-card-padding": {
      "default": "`--ds-space-6`",
      "description": "card padding: the base, 2px less per density step"
    },
    "--ds-card-padding-sm": {
      "default": "`--ds-space-4`",
      "description": "card padding at 600px and below"
    },
    "--ds-card-padding-filled": {
      "default": "`--ds-space-5`",
      "description": "`.ds-card--filled` padding"
    },
    "--ds-card-radius": {
      "default": "`--ds-radius-card`",
      "description": "card radius, times `--ds-shape`"
    },
    "--ds-card-radius-pressed": {
      "default": "`--ds-radius-card-pressed`",
      "description": "an interactive card while pressed (times `--ds-shape`; never rounder than at rest)"
    },
    "--ds-card-bg": {
      "default": "`--ds-surface`",
      "description": "the fill of `.ds-card` and `.ds-card--outlined`"
    },
    "--ds-card-border": {
      "default": "`--ds-line`",
      "description": "the hairline of a card and of `.ds-card__section`"
    },
    "--ds-card-filled-bg": {
      "default": "`--ds-surface-low`",
      "description": "the fill of `.ds-card--filled`"
    },
    "--ds-card-title-line": {
      "default": "24px",
      "description": "line height of `.ds-card__title`; a button, switch or chip in the header row overhangs it, a status chip, badge or tag sits on it (set it with a type role that changes the subtitle line)"
    },
    "--ds-card-hover-shadow": {
      "default": "none (`--elevated`: its own shadow)",
      "description": "`.ds-card--interactive` on hover, not when blocked (a theme may set `var(--ds-elev-hover)`); never a lift"
    },
    "--ds-card-selected-bg": {
      "default": "`--ds-accent`",
      "description": "a selected interactive card"
    },
    "--ds-selected-ring": {
      "default": "`--ds-primary`",
      "description": "the inset ring of a selected tile or card"
    },
    "--ds-card-shadow": {
      "default": "`--ds-elev-1`",
      "description": "`.ds-card--elevated`"
    },
    "--ds-card-check-size": {
      "default": "`--ds-space-5`",
      "description": "the round mark of `.ds-card--selectable`"
    },
    "--ds-card-media-size": {
      "default": "160px",
      "description": "`.ds-card__media` in the row of `.ds-card--horizontal`"
    },
    "--ds-card-body-min": {
      "default": "240px",
      "description": "the room `.ds-card__body` asks for before a horizontal card wraps"
    },
    "--ds-btn-height": {
      "owner": "button"
    },
    "--ds-chip-height": {
      "owner": "chip"
    },
    "--ds-switch-height": {
      "owner": "switch"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-card--interactive"
  ]
}
