{
  "name": "list",
  "group": "data",
  "order": 180,
  "docsOrder": 90,
  "need": "Show label and value pairs, short record lists or runs of small counts",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-facts",
    "ds-facts--bordered",
    "ds-facts--grid",
    "ds-facts--rows",
    "ds-facts--stacked",
    "ds-facts__copy",
    "ds-facts__full",
    "ds-facts__wide",
    "ds-kv-list",
    "ds-kv-list--bars",
    "ds-kv-list--interactive",
    "ds-kv-list__icon",
    "ds-kv-list__row",
    "ds-list",
    "ds-list--interactive",
    "ds-list--scroll",
    "ds-list--stacked",
    "ds-list__action",
    "ds-list__actions",
    "ds-list__aside",
    "ds-list__check",
    "ds-list__chevron",
    "ds-list__description",
    "ds-list__grip",
    "ds-list__group",
    "ds-list__heading",
    "ds-list__icon",
    "ds-list__item",
    "ds-list__media",
    "ds-list__media--round",
    "ds-list__meta",
    "ds-list__text",
    "ds-list__title",
    "ds-lock",
    "ds-parts",
    "ds-parts__list",
    "ds-plain-list"
  ],
  "attributes": [
    "data-ds-dragging",
    "data-ds-glide",
    "data-ds-list-select",
    "data-ds-ripple",
    "data-state"
  ],
  "requires": [
    "button",
    "chart",
    "drag",
    "form",
    "status"
  ],
  "context": [
    "ripple",
    "utilities"
  ],
  "hooks": {
    "--ds-list-item-height": {
      "default": "56px",
      "description": "a `.ds-list` row: the base height (size md, comfortable density) that size and density steps apply to"
    },
    "--ds-list-padding": {
      "default": "`--ds-space-4`",
      "description": "the side padding of a `.ds-list` row, 2px per density step"
    },
    "--ds-list-padding-y": {
      "default": "`--ds-space-3`",
      "description": "the block padding of a `.ds-list` row, 4px per size step, 2px per density step"
    },
    "--ds-list-radius": {
      "default": "`--ds-radius-card`",
      "description": "the corners of a `.ds-list` (times `--ds-shape`)"
    },
    "--ds-list-title-font": {
      "default": "`--ds-size-font` of the size class, else `--ds-font-label`",
      "description": "`.ds-list__title`"
    },
    "--ds-list-media-size": {
      "default": "40px",
      "description": "`.ds-list__media`, 4px per size step"
    },
    "--ds-list-media-radius": {
      "default": "`--ds-radius-sm`",
      "description": "`.ds-list__media` (times `--ds-shape`, at most half its size; `--round`: `--ds-radius-action`)"
    },
    "--ds-list-text-min": {
      "default": "12rem",
      "description": "the width below which a row's trailing parts (status, actions, chevron) drop to a second line"
    },
    "--ds-list-current-bg": {
      "default": "`--ds-accent`",
      "description": "the current row of a `.ds-list` (`aria-current`)"
    },
    "--ds-list-group-bg": {
      "default": "`--ds-surface`",
      "description": "the opaque fill of a sticky `.ds-list__group` row"
    },
    "--ds-list-group-top": {
      "default": "0px",
      "description": "where a `.ds-list__group` row sticks (the height of a sticky page head above it)"
    },
    "--ds-kv-list-padding": {
      "default": "`--ds-space-3`",
      "description": "the block padding of a `.ds-kv-list` row and of `.ds-facts--rows`, 4px per size step, 2px per density step"
    },
    "--ds-facts-label-width": {
      "default": "36%",
      "description": "the label column of `.ds-facts--rows`"
    },
    "--ds-list-selected-bg": {
      "default": "`--ds-accent`",
      "description": "a row of a `.ds-list` whose `.ds-list__check` is checked"
    },
    "--ds-list-max-height": {
      "default": "24rem",
      "description": "the height past which a `.ds-list--scroll` scrolls its rows inside its border"
    },
    "--ds-facts-radius": {
      "default": "`--ds-radius-card`",
      "description": "the corners of `.ds-facts--bordered` (times `--ds-shape`)"
    }
  },
  "keyframes": [],
  "js": [
    "dnd",
    "list",
    "virtual"
  ],
  "module": true,
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-list--interactive > .ds-list__item",
    ":is(a, button).ds-kv-list__row",
    ".ds-list[data-ds-list-select] > .ds-list__item:not(:has(.ds-list__action)):not(:has(> .ds-list__check:disabled))"
  ],
  "labExempt": {
    "DS.list.create": "the drag of its rows is DS.dnd's (the dnd entries play it); selection and the window move nothing",
    "DS.list.facts": "copy buttons: a glyph swap, no motion",
    "DS.list.rangeKeys": "a pure function: no motion",
    "DS.list.allState": "a pure function: no motion"
  }
}
