{
  "name": "list",
  "group": "data",
  "order": 110,
  "docsOrder": 90,
  "classes": [
    "ds-facts",
    "ds-facts--rows",
    "ds-kv-list",
    "ds-kv-list--bars",
    "ds-kv-list--interactive",
    "ds-kv-list__icon",
    "ds-kv-list__icon--error",
    "ds-kv-list__icon--ok",
    "ds-kv-list__icon--warning",
    "ds-kv-list__row",
    "ds-list",
    "ds-list--interactive",
    "ds-list__action",
    "ds-list__actions",
    "ds-list__chevron",
    "ds-list__icon",
    "ds-list__item",
    "ds-list__meta",
    "ds-list__text",
    "ds-list__title",
    "ds-lock",
    "ds-parts",
    "ds-parts__list",
    "ds-plain-list"
  ],
  "attributes": [
    "data-ds-glide"
  ],
  "requires": [
    "chart",
    "status"
  ],
  "context": [
    "card",
    "chip",
    "ripple",
    "tile",
    "utilities"
  ],
  "hooks": {
    "--ds-list-item-height": {
      "default": "56px",
      "description": "the least height of a `.ds-list` row"
    },
    "--ds-list-text-min": {
      "default": "12rem",
      "description": "the width below which a row's trailing parts (status, actions, chevron) drop to a second line"
    },
    "--ds-list-current-bg": {
      "default": "`--ds-accent`",
      "description": "the current row of a `.ds-list` (`aria-current`)"
    },
    "--ds-facts-label-width": {
      "default": "36%",
      "description": "the label column of `.ds-facts--rows`"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [],
  "ripple": true,
  "rippleHosts": [
    ".ds-list--interactive > .ds-list__item",
    ":is(a, button).ds-kv-list__row"
  ]
}
