{
  "name": "prose",
  "group": "content",
  "order": 200,
  "docsOrder": 120,
  "need": "Show rendered rich text, with task lists, callouts, footnotes, heading anchors and a compact mode for chat",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-prose",
    "ds-prose--compact",
    "ds-prose--dense",
    "ds-prose__anchor",
    "ds-prose__callout",
    "ds-prose__callout-title",
    "ds-prose__fnback",
    "ds-prose__fnref",
    "ds-prose__footnotes"
  ],
  "attributes": [
    "data-align"
  ],
  "requires": [
    "code"
  ],
  "context": [],
  "hooks": {
    "--ds-prose-gap": {
      "default": "`--ds-space-2` (`--compact`: `--ds-space-1`)",
      "description": "the gap between blocks of `.ds-prose`: the base, 1px less per density step"
    },
    "--ds-prose-font": {
      "default": "`--ds-font-reading` (`--dense`, `--compact`: `--ds-font-body`)",
      "description": "the text of `.ds-prose`"
    },
    "--ds-prose-strong-weight": {
      "default": "`--ds-weight-label`",
      "description": "`strong` and `b` in `.ds-prose`"
    },
    "--ds-prose-radius": {
      "default": "`--ds-radius-card`",
      "description": "quotes and callouts (times `--ds-shape`)"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [
    "text-wrap",
    "scrollbar-color",
    "hyphenate-limit-chars"
  ],
  "ripple": false,
  "exceptions": {
    "ripple": {
      ".ds-prose__anchor": "a heading's text as an inline link to itself: links in text are the exception to ripple and morph (D11)",
      ".ds-prose__fnback": "an inline text link at the end of a footnote: links in text are the exception to ripple and morph"
    }
  }
}
