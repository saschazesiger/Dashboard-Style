{
  "name": "prose",
  "group": "content",
  "order": 140,
  "docsOrder": 120,
  "need": "Show rendered rich text and blocks of code",
  "tier": 1,
  "status": "stable",
  "classes": [
    "ds-code-block",
    "ds-code-block--wrap",
    "ds-prose",
    "ds-prose--dense"
  ],
  "attributes": [],
  "requires": [],
  "context": [],
  "hooks": {
    "--ds-prose-gap": {
      "default": "`--ds-space-2`",
      "description": "the gap between blocks of `.ds-prose`"
    },
    "--ds-prose-font": {
      "default": "`--ds-font-reading` (`--dense`: `--ds-font-body`)",
      "description": "the text of `.ds-prose`"
    },
    "--ds-prose-strong-weight": {
      "default": "`--ds-weight-label`",
      "description": "`strong` and `b` in `.ds-prose`"
    }
  },
  "keyframes": [],
  "js": [],
  "progressive": [
    "text-wrap",
    "scrollbar-color",
    "hyphenate-limit-chars"
  ],
  "ripple": false
}
